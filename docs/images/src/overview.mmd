flowchart LR
    U([You]) -->|/team-build request| C[Coordinator<br/>classifies, sizes,<br/>hands off, checks]
    C --> PLAN
    subgraph PLAN [Plan]
        A[architect] --- D[ui-designer]
    end
    PLAN -. medium and large work .-> G0{{Gate 0<br/>you pick an approach}}
    G0 -.-> PLAN
    PLAN --> G1{{Gate 1<br/>you approve the plan}}
    G1 --> BUILD
    subgraph BUILD [Build]
        F[frontend-dev] --- B[backend-dev] --- AI[ai-agent-engineer] --- T[test-engineer]
    end
    BUILD --> CHECK
    subgraph CHECK [Check]
        R[code-reviewer] --- V[verifier]
    end
    CHECK --> G2{{Gate 2<br/>you approve shipping}}
    G2 --> O[devops]
    W[(work file:<br/>plan, evidence,<br/>cost, retro)] -.- C
    H{{hooks enforce the rules:<br/>file ownership, risky commands,<br/>tests must pass, resume}} -.- BUILD
    classDef gate fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef guard fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    class G0,G1,G2 gate
    class H guard
